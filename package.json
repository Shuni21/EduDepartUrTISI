{
  "name": "edudepart-urtisi",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:web": "npm run dev --workspace frontend",
    "dev:https": "npm run dev:https --workspace frontend",
    "dev:api": "npm run start:dev --workspace backend",
    "certs:generate": "node certs/generate-certs.mjs",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:web": "npm run build --workspace frontend",
    "build:api": "npm run build --workspace backend",
    "start:api": "npm run start --workspace backend",

    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit": "npm audit --audit-level=high",
    "type-check": "npm run type-check --workspace frontend"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/websockets": "^11.1.27",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1"
  }
}
